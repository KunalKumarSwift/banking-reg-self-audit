# Copy this file to .env and fill in real values. Never commit .env itself.

GOOGLE_CLOUD_PROJECT=
# Gemini via Vertex AI (local runs; Agent Engine sets these itself in the cloud).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=
SEARCH_LOCATION=
AGENT_LOCATION=
SEARCH_ENGINE_ID=
MODEL_NAME=gemini-2.5-flash
# Leave empty for the first deploy; then paste the resource name it prints,
# so later deploys update the same Agent Engine instead of creating a new one.
REASONING_ENGINE_RESOURCE_NAME=
